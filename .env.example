# Shiro Environment Variables
# Copy to .env.local and fill in values
# NEVER commit .env.local to git

# ────────────────────────────────────────
# SUPABASE (Database + Auth)
# ────────────────────────────────────────
# Project URL from Supabase dashboard
SUPABASE_URL=https://your-project.supabase.co

# Anon key - safe for browser (public read policies only)
SUPABASE_ANON_KEY=your-anon-key

# Service role key - NEVER in frontend, ONLY in agent service (server)
SUPABASE_SERVICE_KEY=your-service-role-key

# ────────────────────────────────────────
# LLM (for Agents)
# ────────────────────────────────────────
# OpenAI / Anthropic / other provider API key
LLM_API_KEY=your-llm-api-key

# Optional: specific model override
# LLM_MODEL=gpt-4o-mini

# ────────────────────────────────────────
# TELEGRAM BOT (Approvals)
# ────────────────────────────────────────
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=your-bot-token

# Owner's Telegram chat ID (numeric, allowlist for approvals)
TELEGRAM_OWNER_CHAT_ID=123456789

# ────────────────────────────────────────
# PAYMENT GATEWAYS (Planned)
# ────────────────────────────────────────
# Razorpay
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=xxx
# RAZORPAY_WEBHOOK_SECRET=xxx

# ────────────────────────────────────────
# SHIPPING (Planned)
# ────────────────────────────────────────
# Shiprocket / Delhivery API keys
# SHIPROCKET_EMAIL=xxx
# SHIPROCKET_PASSWORD=xxx

# ────────────────────────────────────────
# APP SETTINGS
# ────────────────────────────────────────
# App URL (for webhooks, emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Store name (shown in UI, emails)
NEXT_PUBLIC_STORE_NAME=Shiro Toys

# Default currency (INR)
NEXT_PUBLIC_CURRENCY=INR

# ────────────────────────────────────────
# FEATURE FLAGS
# ────────────────────────────────────────
# Enable COD payment method
NEXT_PUBLIC_ENABLE_COD=true

# Enable debug logging
DEBUG=false